offset_bottom = 692.0
theme_override_font_sizes/font_size = 60
text = "Operation Puzzle:
Begin with your cursor off of the \"maze\". Hold left click and move the cursor onto the green \"start\" section. Continue holding left click and make your way through it until you reach the red \"finish\" section. If your mouse leaves the puzzle it will flash red and you will get a strike. Additionally, you will fail if you stop holding the left mouse button or if you try to enter without going through the first section. In the case of failure, repeat from the start. The puzzle will flash green upon a successful completion."
label_settings = SubResource("LabelSettings_3vyhl")
autowrap_mode = 2
script = ExtResource("1_4s6v4")

